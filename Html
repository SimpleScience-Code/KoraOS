<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>KoraOS</title>

<link rel="stylesheet" href="KoraOS.css">

</head>

<body>


<div id="desktop">

<!-- About Me -->
    <div class="desktopIcon"
         ondblclick="openWindow('aboutme')">

        <img src="notes.png">

        <p>About Me</p>

    </div>
    
    
    <!-- notes -->
    <div class="desktopIcon"
         ondblclick="openWindow('notes')">

        <img src="notes.png">

        <p>Notes</p>

    </div>


<!-- calculator -->
    <div class="desktopIcon"
         ondblclick="openWindow('calculator')">

        <img src="calculator.png">

        <p>Calculator</p>

    </div>


<!-- Cookie Clicker -->
    <div class="desktopIcon"
         ondblclick="openWindow('cookie')">

        <img src="cookie.png">

        <p>Cookie Clicker</p>

    </div>

<!-- Notes app, copied the same code to about me page. -->
    <div
    class="window"
    id="notesWindow">

        <div class="windowHeader">

            <span> Notes</span>

            <button
            onclick="closeWindow('notes')">

            ✕

            </button>

        </div>

        <div class="windowContent">

            <h2>

                Welcome to KoraOS

            </h2>

            <textarea
            placeholder="Write something..."></textarea>

        </div>

    </div>

<!--About Me Page, 
    new thingy havent decided yet, 16:26: About me, decided it. -->
    <div
    class="window"
    id="aboutmeWindow">

        <div class="windowHeader">  

            <span>
                
                 About Me 
            
            </span>

            <button
            onclick="closeWindow('aboutme')">

            ✕

            </button>

        </div>

        <div class="windowContent">

            <h2>

                Welcome to KoraOS
                <p><b>About Me:</b> I your below average joe software developer, who used to rely heavily on AI for coding, so this time, atleast for this "About Me Page" I'm  gonna complete it without any AI, so no asking chatgpt for the code, just me, this mission, and my creativity, as for the next and upcoming project/s, which will mostly be hardware, since I have a keen interest in the field. But if I ever try software again ill make sure to not use AI and actually learn the stuff I was supposed to before I started, So wish me best of luck, DM me on Slack to roast me or give advice(@SimplifCoder), and remember to always stay curious. Toodle ON!.  </p>
        
            </h2>
        </div>    

    </div>


</div>


<!-- calculator -->
    <div
    class="window"
    id="calculatorWindow">

        <div class="windowHeader">

            <span>

                 Calculator

            </span>

            <button
            onclick="closeWindow('calculator')">

            ✕

            </button>

        </div>

        <div class="windowContent">

            <input
            id="calcDisplay"
            readonly>

            <div class="calcButtons">

                <button onclick="press('7')">7</button>
                <button onclick="press('8')">8</button>
                <button onclick="press('9')">9</button>
                <button onclick="press('/')">÷</button>

                <button onclick="press('4')">4</button>
                <button onclick="press('5')">5</button>
                <button onclick="press('6')">6</button>
                <button onclick="press('*')">×</button>

                <button onclick="press('1')">1</button>
                <button onclick="press('2')">2</button>
                <button onclick="press('3')">3</button>
                <button onclick="press('-')">−</button>

                <button onclick="press('0')">0</button>
                <button onclick="press('.')">.</button>
                <button onclick="calculate()">=</button>
                <button onclick="press('+')">+</button>

                <button
                onclick="clearCalc()">

                C

                </button>

            </div>

        </div>

    </div>

<!-- cookie clicker -->
    <div
    class="window"
    id="cookieWindow">

        <div class="windowHeader">

            <span>

                 Cookie Clicker

            </span>

            <button
            onclick="closeWindow('cookie')">

            ✕

            </button>

        </div>

        <div class="windowContent">

            <h1>

                 Cookie Clicker

            </h1>

            <br>

            <h2 id="cookieCount">

                Cookies: 0

            </h2>

            <br>

            <button
            id="cookieButton">

                🍪

            </button>

            <br><br>

            <h3
            id="cookiePower">

                Cookies Per Click: 1

            </h3>

            <br>

            <button
            id="cookieUpgrade">

                Upgrade

                <br>

                Cost: 10

            </button>

        </div>

    </div>

    

<div id="taskbar">

    <button
    id="startButton">

        KoraOS

    </button>

    <div
    id="runningApps">

    </div>

    <div
    id="clock">

        00:00

    </div>

</div>

<script src="KoraOS.js"></script>

</body>

</html>
